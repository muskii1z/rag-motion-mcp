# rag-motion-mcp local setup (only the values changed from prod.env)
SITE_URL=http://localhost:8020
CSRF_TRUSTED_ORIGINS=http://localhost:8020,http://127.0.0.1:8020
# Exercise list (text) is needed for mapping rag-motion exercises; the rest would fill a nearly full disk
SYNC_EXERCISES_ON_STARTUP=True
SYNC_EXERCISE_IMAGES_CELERY=False
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
DOWNLOAD_INGREDIENTS_FROM=None
ALLOW_REGISTRATION=False
